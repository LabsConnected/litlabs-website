{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".worktrees",
    "litlabs",
    "litlabs-website",
    "Zoo-Code",
    "terminal-server",
    "voice-server",
    "work",
    "OmniRoute",
    "chrome",
    "meta",
    "codex-reference",
    "cli",
    "packages",
    "worker",
    "docs",
    "scripts"
  ]
}
