{
  "name": "@litt/agent-core",
  "version": "0.1.0",
  "description": "Platform-independent LiTT agent core — no React, Next.js, Clerk, or Supabase",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx src/__tests__/*.test.ts",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "tsx": "^4.23.1"
  },
  "engines": {
    "node": ">=22"
  }
}
