      "tests/regression.cjs": "const fs=require('fs');const c=JSON.parse(fs.readFileSync('src/ollama.json','utf8'));const e=c.timeoutMs < c.coldStartMs ? \"timeout \" + c.timeoutMs + \"ms is shorter than model cold start \" + c.coldStartMs + \"ms\" : null;process.exit(e?1:0);\n"
    },
