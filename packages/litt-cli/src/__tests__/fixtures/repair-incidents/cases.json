[
  {
    "id": "broken-marker-fix",
    "description": "Baseline: a BROKEN marker is replaced with HEALTHY; pipeline completes end-to-end.",
    "workspaceFiles": {
      "src/state.txt": "status=BROKEN\n",
      "repro.cjs": "const fs=require('fs');const s=fs.readFileSync('src/state.txt','utf8');if(s.includes('BROKEN')){console.error('BROKEN-SIGNATURE: state is broken');process.exit(1)}console.log('healthy');\n",
      "tests/regression.cjs": "const fs=require('fs');const s=fs.readFileSync('src/state.txt','utf8');process.exit(s.includes('BROKEN')?1:0);\n"
    },
    "job": {
      "version": 1,
      "incident": "state.txt carries a BROKEN marker; the service reports a failure signature on every run.",
      "reproduction": {
        "command": {
          "command": "node",
          "args": [
            "repro.cjs"
          ]
        },
        "expectedFailure": {
          "stream": "stderr",
          "includes": "BROKEN-SIGNATURE"
        }
      },
      "regression": {
        "path": "tests/regression.cjs",
        "command": {
          "command": "node",
          "args": [
            "tests/regression.cjs"
          ]
        }
      },
      "editablePaths": [
        "src"
      ],
      "checks": [
        {
          "name": "state regression",
          "command": {
            "command": "node",
            "args": [
              "tests/regression.cjs"
            ]
          },
          "kind": "focused",
          "required": true
        }
      ]
    },
    "provider": {
      "outcome": "proposal",
      "proposal": {
        "rootCause": "state.txt holds a BROKEN marker; flip it to a healthy status.",
        "patches": [
          {
            "operation": "replace",
            "path": "src/state.txt",
            "search": "status=BROKEN",
            "replacement": "status=HEALTHY"
          }
        ]
      }
    },
    "startArgs": [
      "--yes"
    ],
    "expect": {
      "exitCode": 0,
      "stage": "complete",
      "filesChanged": [
        "src/state.txt"
      ],
      "fileContents": {
        "src/state.txt": "status=HEALTHY\n"
      }
    },
    "scope": "cli"
  },
