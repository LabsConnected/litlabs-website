{
  "name": "@litlabs/litt-cli",
  "version": "0.1.0",
  "description": "LiTT CLI — AI operating system for your terminal",
  "type": "module",
  "bin": {
    "litt": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc"
  },
  "dependencies": {
    "@litt/agent-core": "workspace:*",
    "chalk": "^5.3.0",
    "ink": "^7.1.0",
    "ink-text-input": "^6.0.0",
    "react": "19.2.8",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
