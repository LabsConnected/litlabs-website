{
  "path": "packages/litt-companion",
  "type": "expo-react-native",
  "platforms": ["android", "ios"],
  "primaryPlatform": "android",
  "backend": "https://litlabs.net",
  "framework": "Expo Router",
  "packageManager": "pnpm",
  "validationCommand": "pnpm mobile:check",
  "startCommand": "pnpm mobile:start",
  "buildCommand": "pnpm mobile:build",
  "doctorCommand": "pnpm mobile:doctor",
  "envVars": [
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY"
  ]
}
