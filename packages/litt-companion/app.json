{
  "expo": {
    "name": "LiTT Companion",
    "slug": "litt-companion",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "littcompanion",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": ["android", "ios"],
    "android": {
      "package": "net.litlabs.companion",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "bundleIdentifier": "net.litlabs.companion",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "updates": {
      "url": ""
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
