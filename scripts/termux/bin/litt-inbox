#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

INBOX="$HOME/litt/inbox"
mkdir -p "$INBOX"

echo "LiTT Phone Inbox"
echo "────────────────────────────────────"

count="$(find "$INBOX" -maxdepth 1 -type f -name '*.md' | wc -l)"

if [ "$count" -eq 0 ]; then
  echo "No notes yet."
  echo
  echo 'Create one with: litt-note "your idea"'
  exit 0
fi

find "$INBOX" -maxdepth 1 -type f -name '*.md' -printf '%T@ %f
' \
  | sort -nr \
  | head -n 10 \
  | while read -r _ file; do
      printf '• %s
' "$file"
    done

echo
echo "Total notes: $count"
echo 'Read newest: litt-last'
