#!/data/data/com.termux/files/usr/bin/bash
# litt-supervisor — lightweight supervised task queue for Android agent work.
#
#   litt-supervisor enqueue [--priority N] [--heavy] [--needs-approval]
#                           [--worktree PATH] [--tag KEY] [--max-attempts N]
#                           [--allow-canonical] -- <cmd> [args...]
#   litt-supervisor run [--once]      scheduling pass / resident loop
#   litt-supervisor status [--json]   queue health + memory + runner
#   litt-supervisor list [state]      pending|running|awaiting|done|failed
#   litt-supervisor approve <id>      release an awaiting task into the queue
#   litt-supervisor cancel <id>       terminate a live task / drop a queued one
#   litt-supervisor pause | resume    stop/start scheduling (running tasks
#                                   are NOT killed — they finish truthfully)
#   litt-supervisor logs <id> [N]     tail a task's execution log
#   litt-supervisor report <id>       print the terminal completion report
#   litt-supervisor recover           reconcile running tasks (dead-pid safe)
#
# Design contract (Android):
#   - State is FILES, not memory. The supervisor can die between any two
#     steps and `run` recovers: a claimed task whose recorded pid is dead
#     is finished from its exit-code file when present, otherwise requeued
#     (attempts+1, bounded) — never silently "finished" or duplicated after
#     a confirmed completion.
#   - Task argv is stored base64-of-NUL-joined and executed via execFile
#     semantics (never through a shell). No eval, no string interp.
#   - Each task runs under `setsid` when available, so cancel can signal the
#     whole process group instead of orphaning grandchildren.
#   - Heavy tasks (models, builds, test suites) run under litt-heavy:
#     the device-wide workload mutex + MemAvailable/SwapFree preflight.
#     At most one heavy task is scheduled at a time; a refused heavy task is
#     requeued with backoff, not force-run.
#   - Lightweight tasks may run concurrently (default 2) only while no heavy
#     task is active and only in distinct working directories. MemAvailable
#     must stay above LITT_SUPERVISOR_MIN_MEM_KB (default 1 GiB).
#   - One supervisor scheduler at a time (singleton flock).
#   - Approval gates: tasks flagged needs-approval (explicitly, or
#     auto-flagged by argv scanning for deploy/push/destructive words)
#     sit in awaiting/ until `approve <id>`.
#   - Duplicate prevention: --tag keys (default: hash of worktree+argv)
#     refuse a second live task with the same key.
#   - Worktree isolation: --worktree must be an existing git worktree and is
#     normalized to a physical absolute path. Tasks default to $HOME, never
#     silently into canonical main; targeting the canonical checkout
#     requires --allow-canonical. Concurrent tasks never share a cwd.
#   - Terminal states write reports/<id>.json (status, exit code, attempts,
#     duration, log path) in addition to the per-task log.
#   - Nothing here discards uncommitted git state, deletes user files,
#     or retries forever. Dead-lettered tasks stay on disk for review.
set -u

if [ -d /data/data/com.termux/files/home ]; then
  HOME_DIR=/data/data/com.termux/files/home
else
  HOME_DIR="$HOME"
fi
ROOT="${LITT_SUPERVISOR_DIR:-$HOME_DIR/.litt-supervisor}"
CANON="$HOME_DIR/litt-canonical"
SUP_SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
# litt-heavy is device infra that historically lives in ~/bin; accept a
# $PREFIX/bin install too so either layout works.
if [ -x "$HOME_DIR/bin/litt-heavy" ]; then
  HEAVY="$HOME_DIR/bin/litt-heavy"
elif [ -x "${PREFIX:-/data/data/com.termux/files/usr}/bin/litt-heavy" ]; then
  HEAVY="${PREFIX:-/data/data/com.termux/files/usr}/bin/litt-heavy"
else
  HEAVY="$HOME_DIR/bin/litt-heavy"   # reported missing by select_task
fi

Q="$ROOT/queue"; A="$ROOT/awaiting"; R="$ROOT/running"
D="$ROOT/done";  F="$ROOT/failed";  L="$ROOT/logs"
K="$ROOT/locks"; S="$ROOT/state";   P="$ROOT/reports"
JOURNAL="$S/supervisor.log"
INTERVAL="${LITT_SUPERVISOR_INTERVAL:-2}"
RUN_BACKOFF_S=60          # requeue delay after a dead/interrupted attempt
MAX_JOURNAL=262144        # 256KB cap on the supervisor journal
MAX_LIGHT="${LITT_SUPERVISOR_MAX_LIGHT:-2}"
MAX_HEAVY=1
MAX_TASKS="${LITT_SUPERVISOR_MAX_TASKS:-$((MAX_LIGHT + MAX_HEAVY))}"
MIN_MEM_KB="${LITT_SUPERVISOR_MIN_MEM_KB:-1048576}"   # 1 GiB for light tasks
CANCEL_GRACE_S="${LITT_SUPERVISOR_CANCEL_GRACE_S:-2}"

mkdir -p "$Q" "$A" "$R" "$D" "$F" "$L" "$K" "$S" "$P"

now() { date +%s; }
iso() { date -Is; }
jid() { od -An -N4 -tx1 /dev/urandom | tr -d ' \n'; }   # 8-hex id

journal() {
  printf '%s %s\n' "$(iso)" "$*" >>"$JOURNAL"
  [ "$(wc -c <"$JOURNAL" 2>/dev/null || echo 0)" -le "$MAX_JOURNAL" ] && return 0
  local t="$JOURNAL.tmp.$$"
  tail -n 2000 "$JOURNAL" >"$t" 2>/dev/null && mv "$t" "$JOURNAL"
}

# ── task field I/O (KEY=VALUE lines, no eval) ─────────────────────────
tget() { # tget <file> <key> [default]
  local line
  line=$(grep -m1 "^$2=" "$1" 2>/dev/null || true)
  printf '%s' "${line#*=}"
  [ -n "$line" ] || printf '%s' "${3:-}"
}
tset() { # tset <file> <key> <value>  — replace or append one key line
  local f=$1 k=$2 v=$3 tmp="$1.tmp.$$"
  if grep -q "^$k=" "$f" 2>/dev/null; then
    sed "s|^$k=.*|$k=$v|" "$f" >"$tmp" && mv "$tmp" "$f"
  else
    printf '%s=%s\n' "$k" "$v" >>"$f"
  fi
}

argv_pack() { printf '%s\0' "$@" | base64 | tr -d '\n'; }
argv_unpack() { # echoes argv words, NUL-separated → read -d ''
  base64 -d <<<"$1" 2>/dev/null
}

# ── process identity (same rigor as dex-ctl) ──────────────────────────
proc_alive() { # pid recorded at claim time still alive AND still the task shell
  local p=$1
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null || return 1
  # pid-reuse guard: the recorded start time must match /proc/pid/stat
  local rf="${2:-}" st
  [ -z "$rf" ] || [ ! -f "$rf" ] && return 0
  st=$(awk '{print $22}' "/proc/$p/stat" 2>/dev/null || true)
  [ -n "$st" ] && [ "$st" = "$(cat "$rf" 2>/dev/null)" ]
}

# ── paths / capacity ──────────────────────────────────────────────────
task_cwd() { # effective working directory for a task file (physical path)
  local wt cr
  cr=$(tget "$1" cwd_real)
  if [ -n "$cr" ] && [ -d "$cr" ]; then printf '%s' "$cr"; return 0; fi
  wt=$(tget "$1" worktree)
  if [ -n "$wt" ] && [ -d "$wt" ]; then (cd "$wt" && pwd -P); else (cd "$HOME_DIR" && pwd -P); fi
}

memavail_kb() { awk '/^MemAvailable:/{a=$2}END{print a+0}' /proc/meminfo; }

count_running() { # count_running <heavy:0|1|*>
  local want=$1 n=0 f h
  for f in "$R"/*.task; do
    [ -e "$f" ] || continue
    h=$(tget "$f" heavy 0)
    { [ "$want" = "*" ] || [ "$h" = "$want" ]; } && n=$((n + 1))
  done
  printf '%s' "$n"
}

light_mem_ok() { [ "$(memavail_kb)" -ge "$MIN_MEM_KB" ]; }

heavy_preflight_ok() {
  [ -x "$HEAVY" ] || return 1
  "$HEAVY" check >/dev/null 2>&1
}

# ── enqueue ───────────────────────────────────────────────────────────
cmd_enqueue() {
  local pri=5 heavy=0 appr=0 wt="" tag="" max=3 allow_canon=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --priority) pri=$2; shift 2 ;;
      --heavy) heavy=1; shift ;;
      --needs-approval) appr=1; shift ;;
      --worktree) wt=$2; shift 2 ;;
      --tag) tag=$2; shift 2 ;;
      --max-attempts) max=$2; shift 2 ;;
      --allow-canonical) allow_canon=1; shift ;;
      --) shift; break ;;
      *) echo "enqueue: unknown flag $1"; exit 2 ;;
    esac
  done
  [ $# -gt 0 ] || { echo "enqueue: no command after --"; exit 2; }

  case "$pri" in ''|*[!0-9]*) echo "enqueue: --priority must be an integer 0-9"; exit 2 ;; esac
  [ "$pri" -le 9 ] || { echo "enqueue: --priority must be 0-9"; exit 2; }
  case "$max" in ''|*[!0-9]*) echo "enqueue: --max-attempts must be a positive integer"; exit 2 ;; esac
  [ "$max" -ge 1 ] || { echo "enqueue: --max-attempts must be >= 1"; exit 2; }
  if [ -n "$tag" ]; then
    case "$tag" in *[!A-Za-z0-9._:-]*) echo "enqueue: --tag may only contain [A-Za-z0-9._:-]"; exit 2 ;; esac
    [ "${#tag}" -le 64 ] || { echo "enqueue: --tag too long (max 64)"; exit 2; }
  fi

  local cwd_real
  cwd_real=$(cd "$HOME_DIR" && pwd -P)
  if [ -n "$wt" ]; then
    [ -d "$wt" ] || { echo "enqueue: worktree $wt does not exist"; exit 2; }
    git -C "$wt" rev-parse --git-dir >/dev/null 2>&1 || {
      echo "enqueue: $wt is not a git worktree"; exit 2; }
    wt=$(cd "$wt" && pwd -P)
    cwd_real="$wt"
    if [ "$allow_canon" = 0 ]; then
      local canonreal
      canonreal=$(cd "$CANON" 2>/dev/null && pwd -P || echo x)
      [ "$cwd_real" = "$canonreal" ] && {
        echo "enqueue: refusing canonical main checkout as task worktree"
        echo "  (pass --allow-canonical if this task is genuinely read-mostly)"; exit 2; }
    fi
  fi

  # auto-approval gate on dangerous argv
  local argstr cmdline; printf -v argstr ' %s' "$@"
  cmdline=$(printf '%s' "$*" | tr '\n\r\t' '   ' | cut -c1-500)
  case "$argstr" in
    *git\ push*|*git\ reset\ --hard*|*rm\ -r*|*rm\ -f*|*rm\ -rf\ /*|*deploy*|*publish*|*vercel*|*railway*|*sudo*|*dd\ of=*|*mkfs*|*chmod\ -R\ 777*|*npm\ publish*|*gh\ release*|*reboot*|*shutdown*)
      if [ "$appr" = 0 ]; then
        appr=1; echo "enqueue: argv looks dangerous — forced needs-approval"
      fi ;;
  esac

  local id; id=$(jid)
  [ -z "$tag" ] && tag=$(printf '%s|%s' "$cwd_real" "$argstr" | sha256sum | cut -c1-16)
  # duplicate prevention — refuse if a live task already holds this tag
  for dir in "$Q" "$A" "$R"; do
    for kf in "$dir"/*.task; do
      [ -e "$kf" ] || continue
      [ "$(tget "$kf" tag)" = "$tag" ] && {
        echo "enqueue: duplicate — tag $tag already held by $(basename "$kf" .task) in $(basename "$dir")"
        exit 3; }
    done
  done

  local dest="$Q" st=pending
  [ "$appr" = 1 ] && { dest="$A"; st=awaiting; }
  # filename encodes scheduling order: priority desc, creation ns asc
  local f="$dest/q$((9-pri))-$(date +%s%N)-$id.task"
  {
    printf 'id=%s\n' "$id"
    printf 'tag=%s\n' "$tag"
    printf 'priority=%s\n' "$pri"
    printf 'heavy=%s\n' "$heavy"
    printf 'needs_approval=%s\n' "$appr"
    printf 'worktree=%s\n' "$wt"
    printf 'cwd_real=%s\n' "$cwd_real"
    printf 'argv64=%s\n' "$(argv_pack "$@")"
    printf 'cmdline=%s\n' "$cmdline"
    printf 'created=%s\n' "$(now)"
    printf 'attempts=0\n'
    printf 'max_attempts=%s\n' "$max"
    printf 'status=%s\n' "$st"
    printf 'not_before=0\n'
    printf 'pid=\n'
  } >"$f"
  journal "enqueue $id ($st, pri=$pri, heavy=$heavy, wt=${wt:-none}) :: $cmdline"
  echo "$id  [$st] pri=$pri $cmdline"
}

# ── scheduler ─────────────────────────────────────────────────────────
select_task() { # echoes the best eligible queue file, or returns 1
  local heavy_running light_running total light_ok heavy_ok
  heavy_running=$(count_running 1); light_running=$(count_running 0)
  total=$((heavy_running + light_running))
  [ "$total" -lt "$MAX_TASKS" ] || return 1
  light_ok=0; light_mem_ok && light_ok=1
  heavy_ok=-1   # -1 unknown, 0 no, 1 yes (checked lazily)

  local f nb heavy cwd hcwd conflict
  for f in "$Q"/*.task; do
    [ -e "$f" ] || continue
    nb=$(tget "$f" not_before 0)
    [ "$nb" -gt "$(now)" ] && continue
    heavy=$(tget "$f" heavy 0)

    if [ "$heavy" = 1 ]; then
      # One heavy workload max; heavy may start alongside already-running
      # light tasks only when litt-heavy's own memory preflight passes.
      [ "$heavy_running" -eq 0 ] || continue
      if [ "$heavy_ok" -lt 0 ]; then
        if [ -x "$HEAVY" ] && heavy_preflight_ok; then heavy_ok=1; else heavy_ok=0; fi
      fi
      [ "$heavy_ok" = 1 ] || continue
    else
      # No new light work while a heavy task is active; cap concurrent
      # light agents and require memory headroom.
      [ "$heavy_running" -eq 0 ] || continue
      [ "$light_running" -lt "$MAX_LIGHT" ] || continue
      [ "$light_ok" = 1 ] || continue
    fi

    # Worktree isolation: never run two live tasks in the same cwd.
    cwd=$(task_cwd "$f"); conflict=0
    for rf in "$R"/*.task; do
      [ -e "$rf" ] || continue
      hcwd=$(task_cwd "$rf")
      [ "$hcwd" = "$cwd" ] && { conflict=1; break; }
    done
    [ "$conflict" = 0 ] || continue

    printf '%s' "$f"
    return 0
  done
  return 1
}

write_rc() { # __exec worker records its exit status for crash-safe recovery
  local id=$1 rc=$2 tmp="$R/$id.rc.tmp.$$"
  printf '%s\n' "$rc" >"$tmp" 2>/dev/null && mv "$tmp" "$R/$id.rc" 2>/dev/null
}

cmd_exec_task() { # hidden worker: __exec <running-task-file>
  local f=$1 id heavy argv64 cwd rc
  [ -f "$f" ] || exit 98
  id=$(tget "$f" id); heavy=$(tget "$f" heavy 0); argv64=$(tget "$f" argv64)
  cwd=$(task_cwd "$f")
  cd "$cwd" || { write_rc "$id" 97; exit 97; }
  local -a ARGV=()
  mapfile -d '' -t ARGV < <(argv_unpack "$argv64")
  [ "${#ARGV[@]}" -gt 0 ] || { write_rc "$id" 96; exit 96; }
  if [ "$heavy" = 1 ]; then
    "$HEAVY" "${ARGV[@]}"
  else
    "${ARGV[@]}"
  fi
  rc=$?
  write_rc "$id" "$rc"
  exit "$rc"
}

LAUNCHED_ID=""
task_pid() { # task_pid <task-file> — field first, pid sidecar as fallback
  local f=$1 p id
  p=$(tget "$f" pid)
  [ -n "$p" ] && { printf '%s' "$p"; return 0; }
  id=$(tget "$f" id)
  [ -n "$id" ] && cat "$R/$id.pid" 2>/dev/null
}

cancel_launch_record() { # a cancel landed while the claim was being written
  local rf=$1 id
  id=$(tget "$rf" id)
  tset "$rf" status cancelled; tset "$rf" finished "$(iso)"
  write_report "$rf" cancelled ""
  mv "$rf" "$D/$(basename "$rf")"
  rm -f "$R/$id.starttime" "$R/$id.cancel" "$R/$id.pid" "$R/$id.rc"
  journal "task $id CANCELLED before worker spawn"
}

launch_task() { # claim + spawn the given queue file; echoes nothing on success
  local f=$1 rf id="" tag="" pri="" heavy="" appr="" wt="" cwd_real=""
  local argv64="" cmdline="" created="" attempts=0 maxa=3 k v p st started_iso started_epoch cwd tmp heartbeat_epoch
  rf="$R/$(basename "$f")"

  # Parse the small KEY=VALUE file once — per-field tget/tset forks made a
  # claim take multiple seconds on a loaded phone and widened cancel races.
  while IFS='=' read -r k v; do
    case "$k" in
      id) id=$v ;; tag) tag=$v ;; priority) pri=$v ;; heavy) heavy=$v ;;
      needs_approval) appr=$v ;; worktree) wt=$v ;; cwd_real) cwd_real=$v ;;
      argv64) argv64=$v ;; cmdline) cmdline=$v ;; created) created=$v ;;
      attempts) attempts=$v ;; max_attempts) maxa=$v ;;
    esac
  done <"$f"
  [ -n "$id" ] && [ -n "$argv64" ] || return 1
  mv "$f" "$rf" || return 1

  attempts=$((attempts + 1))
  started_iso=$(iso); started_epoch=$(now)
  cwd="${cwd_real:-}"
  [ -n "$cwd" ] && [ -d "$cwd" ] || cwd=$(task_cwd "$rf")
  heartbeat_epoch=$started_epoch

  tmp="$rf.tmp.$$"
  {
    printf 'id=%s\n' "$id"
    printf 'tag=%s\n' "$tag"
    printf 'priority=%s\n' "$pri"
    printf 'heavy=%s\n' "$heavy"
    printf 'needs_approval=%s\n' "$appr"
    printf 'worktree=%s\n' "$wt"
    printf 'cwd_real=%s\n' "$cwd"
    printf 'argv64=%s\n' "$argv64"
    printf 'cmdline=%s\n' "$cmdline"
    printf 'created=%s\n' "$created"
    printf 'attempts=%s\n' "$attempts"
    printf 'max_attempts=%s\n' "$maxa"
    printf 'status=running\n'
    printf 'not_before=0\n'
    printf 'pid=\n'
    printf 'started=%s\n' "$started_iso"
    printf 'started_epoch=%s\n' "$started_epoch"
    printf 'heartbeat=%s\n' "$heartbeat_epoch"
  } >"$tmp" && mv "$tmp" "$rf" || { rm -f "$tmp"; return 1; }

  # A cancel that landed while the claim was being written must not spawn.
  if [ -f "$R/$id.cancel" ]; then cancel_launch_record "$rf"; LAUNCHED_ID=""; return 0; fi

  journal "task $id RUN in $cwd :: $cmdline (attempt $attempts/$maxa)"
  # setsid gives the task its own process group so cancel can reap the
  # whole tree; plain background exec is the portable fallback.
  if command -v setsid >/dev/null 2>&1; then
    setsid bash "$SUP_SELF" __exec "$rf" >>"$L/$id.log" 2>&1 &
  else
    bash "$SUP_SELF" __exec "$rf" >>"$L/$id.log" 2>&1 &
  fi
  p=$!
  LAUNCHED_ID="$id"
  echo "$p" >"$R/$id.pid"
  tset "$rf" pid "$p"
  # Give the worker a moment to exec before sampling /proc start time; a
  # missing starttime file is treated as "alive but unverifiable", never
  # as dead, so this cannot cause a false requeue.
  st=""
  for _ in 1 2 3 4 5; do
    st=$(awk '{print $22}' "/proc/$p/stat" 2>/dev/null || true)
    [ -n "$st" ] && break
    sleep 0.1
  done
  [ -n "$st" ] && printf '%s\n' "$st" >"$R/$id.starttime"
}

json_escape() {
  printf '%s' "$1" | tr '\n\r\t' '   ' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

write_report() { # terminal completion report → reports/<id>.json
  local f=$1 status=$2 rc=$3 id out tmp dur="null"
  id=$(tget "$f" id); out="$P/$id.json"; tmp="$out.tmp.$$"
  local started_epoch; started_epoch=$(tget "$f" started_epoch 0)
  [ "$started_epoch" != "0" ] && dur=$(( $(now) - started_epoch ))
  {
    printf '{\n'
    printf '  "id": "%s",\n' "$(json_escape "$id")"
    printf '  "tag": "%s",\n' "$(json_escape "$(tget "$f" tag)")"
    printf '  "status": "%s",\n' "$status"
    printf '  "exit_code": %s,\n' "${rc:-null}"
    printf '  "cmdline": "%s",\n' "$(json_escape "$(tget "$f" cmdline)")"
    printf '  "worktree": "%s",\n' "$(json_escape "$(tget "$f" worktree)")"
    printf '  "cwd": "%s",\n' "$(json_escape "$(task_cwd "$f")")"
    printf '  "priority": %s,\n' "$(tget "$f" priority 0)"
    printf '  "heavy": %s,\n' "$(tget "$f" heavy 0)"
    printf '  "attempts": %s,\n' "$(tget "$f" attempts 0)"
    printf '  "max_attempts": %s,\n' "$(tget "$f" max_attempts 3)"
    printf '  "created": %s,\n' "$(tget "$f" created 0)"
    printf '  "started_epoch": %s,\n' "${started_epoch:-null}"
    printf '  "finished_epoch": %s,\n' "$(now)"
    printf '  "duration_s": %s,\n' "$dur"
    printf '  "pid": "%s",\n' "$(tget "$f" pid)"
    printf '  "log": "%s",\n' "$(json_escape "$L/$id.log")"
    printf '  "report": "%s"\n' "$(json_escape "$out")"
    printf '}\n'
  } >"$tmp" 2>/dev/null && mv "$tmp" "$out" 2>/dev/null || rm -f "$tmp"
}

finish_task() { # finish_task <file> <exitcode> — terminal or bounded requeue
  local f=$1 rc=$2 id status dest at maxa
  id=$(tget "$f" id); at=$(tget "$f" attempts 0); maxa=$(tget "$f" max_attempts 3)
  case "$rc" in ''|*[!0-9]*) rc=137 ;; esac
  if [ "$rc" = 0 ]; then
    status=done
  elif [ "$at" -ge "$maxa" ]; then
    status=failed
  else
    status=""
  fi

  if [ -n "$status" ]; then
    tset "$f" status "$status"; tset "$f" exit_code "$rc"; tset "$f" finished "$(iso)"
    write_report "$f" "$status" "$rc"
    dest=$D; [ "$status" = failed ] && dest=$F
    mv "$f" "$dest/$(basename "$f")"
    journal "task $id $status rc=$rc (attempt $at/$maxa)"
  else
    tset "$f" status pending; tset "$f" pid ""
    tset "$f" not_before "$(($(now)+RUN_BACKOFF_S))"
    mv "$f" "$Q/$(basename "$f")"
    journal "task $id rc=$rc → requeued (attempt $at/$maxa)"
  fi
  rm -f "$R/$id.starttime" "$R/$id.cancel" "$R/$id.pid" "$R/$id.rc"
}

cancel_running() { # cancel_running <running-task-file> — group kill + terminal state
  local f=$1 id p
  id=$(tget "$f" id); p=$(task_pid "$f")
  [ -n "$p" ] && { kill -- "-$p" 2>/dev/null || kill "$p" 2>/dev/null; }
  sleep "$CANCEL_GRACE_S"
  [ -n "$p" ] && { kill -9 -- "-$p" 2>/dev/null || kill -9 "$p" 2>/dev/null; }
  [ -n "$p" ] && wait "$p" 2>/dev/null || true
  tset "$f" status cancelled; tset "$f" finished "$(iso)"
  write_report "$f" cancelled ""
  mv "$f" "$D/$(basename "$f")"
  rm -f "$R/$id.starttime" "$R/$id.cancel" "$R/$id.pid" "$R/$id.rc"
  journal "task $id CANCELLED by user"
}

reconcile() { # heartbeat live tasks; finish dead ones from rcfile or requeue
  local f id p rc
  for f in "$R"/*.task; do
    [ -e "$f" ] || continue
    id=$(tget "$f" id); p=$(task_pid "$f")
    if [ -f "$R/$id.cancel" ]; then cancel_running "$f"; continue; fi
    if proc_alive "$p" "$R/$id.starttime"; then
      tset "$f" heartbeat "$(now)"
      continue
    fi
    # Dead: prefer the worker's recorded exit code so a task that finished
    # while the supervisor was down is NOT re-executed. Missing rc means
    # the worker itself was killed — bounded requeue via finish_task(137).
    [ -n "$p" ] && wait "$p" 2>/dev/null || true
    if [ -f "$R/$id.rc" ]; then
      rc=$(cat "$R/$id.rc" 2>/dev/null || echo 137)
      rm -f "$R/$id.rc"
    else
      rc=137
    fi
    finish_task "$f" "$rc"
  done
}

run_once_task() { # synchronous single-task pass (legacy run --once)
  reconcile
  if [ -f "$S/paused" ]; then echo "supervisor is PAUSED (resume to schedule)"; return 1; fi
  local f; f=$(select_task) || { echo "no due tasks"; return 1; }
  launch_task "$f" || { echo "launch failed for $(basename "$f")"; return 1; }
  local id="$LAUNCHED_ID" rf found
  if [ -z "$id" ]; then echo "task cancelled before worker start"; return 0; fi
  while :; do
    reconcile
    found=""
    for rf in "$R"/*-"$id".task; do [ -e "$rf" ] && { found=1; break; }; done
    [ -z "$found" ] && break
    sleep 0.2
  done
  for rf in "$D"/*-"$id".task "$F"/*-"$id".task; do
    [ -e "$rf" ] || continue
    echo "task $id $(tget "$rf" status) rc=$(tget "$rf" exit_code)"
    return 0
  done
  echo "task $id ended without a terminal record"
  return 1
}

cmd_run() {
  local once=0; [ "${1:-}" = "--once" ] && once=1
  exec 9>"$S/supervisor.lock"
  flock -n 9 || { echo "run: another supervisor holds the lock"; exit 3; }
  echo $$ >"$S/supervisor.pid"
  reconcile
  if [ "$once" = 1 ]; then run_once_task; exit $?; fi
  echo "litt-supervisor running (interval ${INTERVAL}s, root $ROOT; max light=$MAX_LIGHT heavy=$MAX_HEAVY mem>=${MIN_MEM_KB}kB)"
  journal "supervisor started pid $$"
  while :; do
    reconcile
    if [ ! -f "$S/paused" ]; then
      local f
      while f=$(select_task); do
        launch_task "$f" || break
      done
    fi
    sleep "$INTERVAL"
  done
}

# ── inspection / control ──────────────────────────────────────────────
count_tasks() { local n=0 t; for t in "$1"/*.task; do [ -e "$t" ] && n=$((n+1)); done; echo "$n"; }
count_reports() { local n=0 t; for t in "$P"/*.json; do [ -e "$t" ] && n=$((n+1)); done; echo "$n"; }

cmd_status() {
  local p q a r d f reps
  q=$(count_tasks "$Q"); a=$(count_tasks "$A")
  r=$(count_tasks "$R"); d=$(count_tasks "$D")
  f=$(count_tasks "$F"); reps=$(count_reports)
  if [ "${1:-}" = "--json" ]; then
    printf '{"pending":%s,"awaiting":%s,"running":%s,"done":%s,"failed":%s,"reports":%s,"paused":%s,"memAvailableKb":%s,"maxLight":%s,"maxHeavy":%s}\n' \
      "$q" "$a" "$r" "$d" "$f" "$reps" "$([ -f "$S/paused" ] && echo true || echo false)" "$(memavail_kb)" "$MAX_LIGHT" "$MAX_HEAVY"
    return 0
  fi
  echo "=== litt-supervisor $(iso) ==="
  echo "queue: $q pending · $a awaiting-approval · $r running · $d done · $f failed · $reps reports"
  [ -f "$S/paused" ] && echo "state: PAUSED"
  awk '/^MemAvailable:/{a=$2}/^SwapTotal:/{t=$2}/^SwapFree:/{sf=$2}
       END{printf "mem:   %d kB avail · swap %d%% free · light floor %d kB\n", a, (t?sf*100/t:0), '"$MIN_MEM_KB"'}' /proc/meminfo
  for t in "$R"/*.task; do
    [ -e "$t" ] || continue
    local id p hb cwd; id=$(tget "$t" id); p=$(task_pid "$t"); hb=$(tget "$t" heartbeat 0); cwd=$(task_cwd "$t")
    if proc_alive "$p" "$R/$id.starttime"; then
      echo "running: $id (pid $p, heartbeat $(( $(now) - hb ))s ago, heavy=$(tget "$t" heavy 0)) — $(tget "$t" cmdline | cut -c1-70) [$cwd]"
    else
      echo "running: $id (pid $p DEAD — will reconcile on next pass)"
    fi
  done
}

cmd_list() {
  local dir; case "${1:-pending}" in
    pending) dir=$Q ;; running) dir=$R ;; awaiting) dir=$A ;;
    done) dir=$D ;; failed) dir=$F ;; *) echo "list: unknown state $1"; exit 2 ;;
  esac
  for t in "$dir"/*.task; do
    [ -e "$t" ] || continue
    printf '%s  [%s] pri=%s att=%s/%s heavy=%s :: %s\n' \
      "$(tget "$t" id)" "$(tget "$t" status)" "$(tget "$t" priority)" \
      "$(tget "$t" attempts 0)" "$(tget "$t" max_attempts 3)" \
      "$(tget "$t" heavy 0)" "$(tget "$t" cmdline | cut -c1-70)"
  done
}

cmd_approve() {
  local id=$1 f
  f=$(ls "$A"/*-"$id".task 2>/dev/null | head -1)
  [ -n "$f" ] || { echo "approve: no awaiting task $id"; exit 4; }
  tset "$f" status pending; mv "$f" "$Q/$(basename "$f")"
  journal "approved $id"; echo "approved $id → queued"
}

cmd_cancel() {
  local id=$1 f
  f=$(ls "$R"/*-"$id".task 2>/dev/null | head -1)
  if [ -n "$f" ]; then
    : >"$R/$id.cancel"; echo "cancel requested for running task $id (scheduler reconciles within ~${INTERVAL}s)"
    return 0
  fi
  for dir in "$Q" "$A"; do
    f=$(ls "$dir"/*-"$id".task 2>/dev/null | head -1)
    [ -n "$f" ] || continue
    tset "$f" status cancelled; tset "$f" finished "$(iso)"
    write_report "$f" cancelled ""
    mv "$f" "$D/$(basename "$f")"; journal "cancelled $id (was queued)"
    echo "cancelled $id"; return 0
  done
  echo "cancel: no live task $id"; exit 4
}

cmd_logs() {
  local id=$1 n="${2:-40}"
  [ -f "$L/$id.log" ] || { echo "no log for $id"; exit 4; }
  tail -n "$n" "$L/$id.log"
}

cmd_report() {
  local id=$1 f="$P/$1.json"
  [ -f "$f" ] || { echo "no report for $id"; exit 4; }
  cat "$f"
}

case "${1:-status}" in
  enqueue) shift; cmd_enqueue "$@" ;;
  __exec) shift; cmd_exec_task "$@" ;;
  run) shift; cmd_run "$@" ;;
  recover) reconcile; echo "recovery pass done" ;;
  status) shift; cmd_status "$@" ;;
  list) shift; cmd_list "$@" ;;
  approve) shift; cmd_approve "$@" ;;
  cancel) shift; cmd_cancel "$@" ;;
  pause) : >"$S/paused"; journal "paused"; echo "paused (running tasks finish, nothing new starts)" ;;
  resume) rm -f "$S/paused"; journal "resumed"; echo "resumed" ;;
  logs) shift; cmd_logs "$@" ;;
  report) shift; cmd_report "$@" ;;
  *) cat <<'EOF'
litt-supervisor — supervised task queue for Android agent work
  enqueue [--priority N] [--heavy] [--needs-approval] [--worktree P]
          [--tag K] [--max-attempts N] [--allow-canonical] -- cmd args...
  run [--once]      schedule due tasks (loop, or a single task with --once)
  status [--json]   queue health · list [pending|running|awaiting|done|failed]
  approve <id>      release a gated task · cancel <id> · pause · resume
  logs <id> [N]     execution log tail · report <id> — completion JSON
  recover           reconcile dead runners without duplicating finished work
EOF
      exit 2 ;;
esac
