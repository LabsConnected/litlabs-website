# litt-backup configuration — sourced by litt-backup + litt-backup-sched
CANON=/data/data/com.termux/files/home/litt-canonical
LITT_BACKUP_ROOT=/data/data/com.termux/files/home/litt-backups/system
LITT_BACKUP_STATE=/data/data/com.termux/files/home/litt-backup/state

# Layer 2 — PC over Tailscale (see ~/.config/devin/AGENTS.md PC section)
PC_TARGET=litbi@100.107.123.73
PC_PORT=2222
PC_KEY=/data/data/com.termux/files/home/.ssh/litt_pc
PC_DIR=litt-phone-backups

# Layer 3 — private cloud. Set to an rclone remote name once configured
# (rclone config -> private remote). Empty = layer pending, stays queued.
CLOUD_REMOTE=

# Resource guards
MIN_FREE_GB=3

# Retention (activates only after first successful `litt-backup verify`)
KEEP_DAILY=7
KEEP_SNAP=4
KEEP_INCR=48
PC_KEEP_DAILY=14
PC_KEEP_WEEKLY=4
