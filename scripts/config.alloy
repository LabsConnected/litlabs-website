/**
 * Alloy configuration for Grafana Cloud observability (metrics + logs).
 *
 * Collects:
 *   - Windows host metrics (CPU, disk, network, memory, services)
 *   - Next.js app metrics (LLM calls, agent runs, eval scores, HTTP)
 *   - Windows Event Logs (Application + System)
 *
 * Forwards to Grafana Cloud via:
 *   - Prometheus remote_write (metrics)
 *   - Loki write (logs)
 *
 * Secrets are read from environment variables via sys.env() — never
 * hardcoded. Required env vars:
 *   GCLOUD_RW_API_KEY  — Grafana Cloud access policy token (metrics:write + logs:write)
 *   GCLOUD_LOKI_URL    — Loki push URL (e.g. https://logs-prod-XXX-us-east-2.grafana.net)
 *
 * The Prometheus username and URL are baked in (not secrets):
 *   User: 3425326
 *   URL:  https://prometheus-prod-56-prod-us-east-2.grafana.net/api/prom/push
 */

// ─── Self-monitoring (Alloy's own metrics) ─────────────────────────
prometheus.exporter.self "alloy_check" {}

discovery.relabel "alloy_check" {
  targets = prometheus.exporter.self.alloy_check.targets

  rule {
    target_label = "instance"
    replacement  = "alloy"
  }

  rule {
    target_label = "job"
    replacement  = "integrations/alloy"
  }
}

prometheus.scrape "alloy_check" {
  targets         = discovery.relabel.alloy_check.output
  forward_to      = [prometheus.relabel.alloy_check.receiver]
  scrape_interval = "60s"
}

prometheus.relabel "alloy_check" {
  forward_to = [prometheus.remote_write.grafanacloud.receiver]

  rule {
    target_label = "instance"
    replacement  = "alloy"
  }
}

// ─── Windows host metrics ──────────────────────────────────────────
prometheus.exporter.windows "integrations_windows_exporter" {
  enabled_collectors = [
    "cpu",
    "cs",
    "logical_disk",
    "memory",
    "net",
    "os",
    "service",
    "system",
    "time",
    "diskdrive",
  ]
}

discovery.relabel "integrations_windows_exporter" {
  targets = prometheus.exporter.windows.integrations_windows_exporter.targets

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  rule {
    target_label = "job"
    replacement  = "integrations/windows_exporter"
  }
}

prometheus.scrape "integrations_windows_exporter" {
  targets    = discovery.relabel.integrations_windows_exporter.output
  forward_to = [prometheus.relabel.integrations_windows_exporter.receiver]
  job_name   = "integrations/windows_exporter"
}

prometheus.relabel "integrations_windows_exporter" {
  forward_to = [prometheus.remote_write.grafanacloud.receiver]

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

// ─── Next.js app metrics (litlabs.net) ─────────────────────────────
// Scrapes the /metrics endpoint exposed by the Next.js app.
// In dev, the app runs on http://localhost:3000.
// In production, update the target to the deployed URL or keep localhost
// if Alloy runs on the same host.
discovery.relabel "litlabs_app" {
  targets = [{
    "__address__" = "localhost:3000",
  }]

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  rule {
    target_label = "job"
    replacement  = "litlabs/app"
  }
}

prometheus.scrape "litlabs_app" {
  targets         = discovery.relabel.litlabs_app.output
  forward_to      = [prometheus.relabel.litlabs_app.receiver]
  scrape_interval = "15s"
  metrics_path    = "/metrics"
}

prometheus.relabel "litlabs_app" {
  forward_to = [prometheus.remote_write.grafanacloud.receiver]

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

// ─── Prometheus remote_write to Grafana Cloud ──────────────────────
prometheus.remote_write "grafanacloud" {
  endpoint {
    url = "https://prometheus-prod-56-prod-us-east-2.grafana.net/api/prom/push"

    basic_auth {
      username = "3425326"
      password = sys.env("GCLOUD_RW_API_KEY")
    }
  }
}

// ─── Loki write to Grafana Cloud ───────────────────────────────────
// GCLOUD_LOKI_URL must be set as a machine env var (e.g.
// https://logs-prod-XXX-us-east-2.grafana.net/loki/api/v1/push)
loki.write "grafana_cloud_loki" {
  endpoint {
    url = sys.env("GCLOUD_LOKI_URL")

    basic_auth {
      username = "3425326"
      password = sys.env("GCLOUD_RW_API_KEY")
    }
  }
}

// ─── Windows Event Logs → Loki ─────────────────────────────────────
// Application event log
loki.relabel "logs_integrations_windows_exporter_application" {
  forward_to = [loki.write.grafana_cloud_loki.receiver]

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  rule {
    target_label = "job"
    replacement  = "integrations/windows_exporter"
  }
}

loki.source.windowsevent "logs_integrations_windows_exporter_application" {
  locale                  = 1033
  eventlog_name           = "Application"
  bookmark_path           = "./bookmarks-app.xml"
  poll_interval           = "0s"
  use_incoming_timestamp  = true
  forward_to              = [loki.relabel.logs_integrations_windows_exporter_application.receiver]
  labels                  = {
    source = "windows-eventlog-application",
  }
}

// System event log
loki.relabel "logs_integrations_windows_exporter_system" {
  forward_to = [loki.write.grafana_cloud_loki.receiver]

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  rule {
    target_label = "job"
    replacement  = "integrations/windows_exporter"
  }
}

loki.source.windowsevent "logs_integrations_windows_exporter_system" {
  locale                  = 1033
  eventlog_name           = "System"
  bookmark_path           = "./bookmarks-sys.xml"
  poll_interval           = "0s"
  use_incoming_timestamp  = true
  forward_to              = [loki.relabel.logs_integrations_windows_exporter_system.receiver]
  labels                  = {
    source = "windows-eventlog-system",
  }
}
