{
  "name": "LiTTree — AI Workflow Orchestration",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-orchestrate",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-ai",
      "name": "AI Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "ai-orchestrate"
    },
    {
      "parameters": {
        "functionCode": "// Extract prompt and context\nconst body = $input.first().json.body || $input.first().json;\nreturn [{ json: { prompt: body.prompt, context: body.context || '', model: body.model || 'gpt-4o-mini' } }];"
      },
      "id": "func-ai",
      "name": "Parse Request",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "model": "={{ $json.model }}",
        "messages": {
          "messageValues": [
            { "role": "system", "content": "You are LiTT, the AI operator for LiTTree Lab Studios. Process the following request and return a structured response." },
            { "role": "user", "content": "={{ $json.prompt }}" }
          ]
        },
        "options": {}
      },
      "id": "openai-1",
      "name": "AI Step 1",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "functionCode": "// Transform AI output for next step\nconst response = $input.first().json.message?.content || $input.first().json.text || '';\nreturn [{ json: { ai_response: response, needs_refinement: response.length > 500 } }];"
      },
      "id": "func-ai-2",
      "name": "Evaluate Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "model": "gemini-1.5-flash",
        "messages": {
          "messageValues": [
            { "role": "user", "content": "=Refine and format this response for the user: {{ $json.ai_response }}" }
          ]
        },
        "options": {}
      },
      "id": "gemini-1",
      "name": "Refine (Gemini)",
      "type": "n8n-nodes-base.googleGemini",
      "typeVersion": 1,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "AI Request": { "main": [[{ "node": "Parse Request", "type": "main", "index": 0 }]] },
    "Parse Request": { "main": [[{ "node": "AI Step 1", "type": "main", "index": 0 }]] },
    "AI Step 1": { "main": [[{ "node": "Evaluate Response", "type": "main", "index": 0 }]] },
    "Evaluate Response": { "main": [[{ "node": "Refine (Gemini)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
