{
  "name": "LiTTree — GitHub to Supabase Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "github-sync",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-gh",
      "name": "GitHub Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "github-sync"
    },
    {
      "parameters": {
        "functionCode": "// Parse GitHub event\nconst body = $input.first().json.body || $input.first().json;\nconst event = body.action || 'unknown';\nconst repo = body.repository?.full_name || 'unknown';\nconst pr = body.pull_request;\nconst issue = body.issue;\nreturn [{ json: { event, repo, pr, issue, raw: body } }];"
      },
      "id": "func-gh",
      "name": "Parse GitHub Event",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "id": "cond-pr", "leftValue": "={{ $json.event }}", "rightValue": "opened", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-pr",
      "name": "Is PR Opened?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "upsert",
        "tableId": "github_events",
        "options": {}
      },
      "id": "supabase-gh",
      "name": "Upsert to Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [850, 200]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "options": {}
      },
      "id": "discord-gh",
      "name": "Notify Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 1,
      "position": [1050, 200]
    }
  ],
  "connections": {
    "GitHub Webhook": { "main": [[{ "node": "Parse GitHub Event", "type": "main", "index": 0 }]] },
    "Parse GitHub Event": { "main": [[{ "node": "Is PR Opened?", "type": "main", "index": 0 }]] },
    "Is PR Opened?": { "main": [[{ "node": "Upsert to Supabase", "type": "main", "index": 0 }], []] },
    "Upsert to Supabase": { "main": [[{ "node": "Notify Discord", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
