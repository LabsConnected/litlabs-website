{
  "name": "LiTTree — Stripe Entitlement Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "litt-stripe-entitlement",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-stripe",
      "name": "Stripe Entitlement Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "litt-stripe-entitlement"
    },
    {
      "parameters": {
        "functionCode": "// Extract Stripe event from signed LiTTree payload\nconst body = $input.first().json.body || $input.first().json;\nconst data = body.data || {};\nconst stripeEvent = data.stripeEvent || body.raw || {};\nconst obj = stripeEvent.data?.object || {};\nreturn [{\n  json: {\n    eventType: body.eventType || stripeEvent.type || 'unknown',\n    customerId: obj.customer || data.customerId || '',\n    subscriptionId: obj.subscription || obj.id || data.subscriptionId || '',\n    planId: data.planId || obj.plan?.id || '',\n    amount: obj.amount_total || obj.amount || data.amount || 0,\n    currency: obj.currency || 'usd',\n    userId: body.userId || data.userId || '',\n    projectId: body.projectId || 'platform',\n    idempotencyKey: body.idempotencyKey || '',\n    callbackUrl: body.callbackUrl || '',\n    raw: body\n  }\n}];"
      },
      "id": "func-parse-stripe",
      "name": "Parse Stripe Event",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "functionCode": "// Verify Stripe webhook signature using the Stripe secret\n// In production this calls Stripe's signature verification.\n// Here we validate the event was received from the LiTTree bridge\n// (already HMAC-signed) and that a Stripe event type is present.\nconst item = $input.first().json;\nconst valid = Boolean(item.eventType && item.eventType.startsWith('') && item.customerId);\nreturn [{ json: { ...item, signatureValid: valid } }];"
      },
      "id": "func-verify-sig",
      "name": "Verify Stripe Signature",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-sig-valid",
              "leftValue": "={{ $json.signatureValid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-sig-valid",
      "name": "Signature Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "upsert",
        "tableId": "user_plans",
        "options": {}
      },
      "id": "supabase-update-plan",
      "name": "Update Plan in Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1050, 200],
      "credentials": {
        "supabase": {
          "id": "supabase-default",
          "name": "LiTTree Supabase"
        }
      }
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "tableId": "wallet_transactions",
        "options": {}
      },
      "id": "supabase-littbits",
      "name": "Add LiTTBits (RPC)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1250, 200],
      "credentials": {
        "supabase": {
          "id": "supabase-default",
          "name": "LiTTree Supabase"
        }
      }
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "tableId": "billing_events",
        "options": {}
      },
      "id": "supabase-billing",
      "name": "Record Billing Event",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1450, 200],
      "credentials": {
        "supabase": {
          "id": "supabase-default",
          "name": "LiTTree Supabase"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "subject": "LiTTree — Payment Receipt",
        "options": {}
      },
      "id": "gmail-receipt",
      "name": "Send Receipt Notification",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1650, 200],
      "credentials": {
        "gmail": {
          "id": "gmail-default",
          "name": "LiTTree Gmail"
        }
      }
    }
  ],
  "connections": {
    "Stripe Entitlement Webhook": { "main": [[{ "node": "Parse Stripe Event", "type": "main", "index": 0 }]] },
    "Parse Stripe Event": { "main": [[{ "node": "Verify Stripe Signature", "type": "main", "index": 0 }]] },
    "Verify Stripe Signature": { "main": [[{ "node": "Signature Valid?", "type": "main", "index": 0 }]] },
    "Signature Valid?": {
      "main": [
        [{ "node": "Update Plan in Supabase", "type": "main", "index": 0 }],
        []
      ]
    },
    "Update Plan in Supabase": { "main": [[{ "node": "Add LiTTBits (RPC)", "type": "main", "index": 0 }]] },
    "Add LiTTBits (RPC)": { "main": [[{ "node": "Record Billing Event", "type": "main", "index": 0 }]] },
    "Record Billing Event": { "main": [[{ "node": "Send Receipt Notification", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "errorWorkflow": "litt-failure-alerts" }
}
