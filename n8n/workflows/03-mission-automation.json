{
  "name": "LiTTree — Mission Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "litt-mission-event",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-mission",
      "name": "Mission Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "litt-mission-event"
    },
    {
      "parameters": {
        "functionCode": "// Extract approved mission event from signed LiTTree payload\nconst body = $input.first().json.body || $input.first().json;\nconst data = body.data || {};\nreturn [{\n  json: {\n    missionId: body.missionId || data.missionId || null,\n    userId: body.userId || '',\n    projectId: body.projectId || 'platform',\n    eventType: body.eventType || 'mission.event',\n    approvedAction: body.approvedAction || '',\n    idempotencyKey: body.idempotencyKey || '',\n    callbackUrl: body.callbackUrl || '',\n    integrationTarget: data.integrationTarget || '',\n    integrationPayload: data.integrationPayload || {},\n    raw: body\n  }\n}];"
      },
      "id": "func-parse-mission",
      "name": "Parse Mission Event",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-approved",
              "leftValue": "={{ $json.approvedAction }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isNotEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-approved",
      "name": "Is Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.integrationTarget }}",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "payload", "value": "={{ JSON.stringify($json.integrationPayload) }}" }
          ]
        },
        "options": {}
      },
      "id": "http-integration",
      "name": "Run External Integration",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 200]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "tableId": "mission_results",
        "options": {}
      },
      "id": "supabase-results",
      "name": "Write Results to Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1050, 200],
      "credentials": {
        "supabase": {
          "id": "supabase-default",
          "name": "LiTTree Supabase"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "// Build callback payload to update dashboard activity\nconst result = $input.first().json;\nreturn [{\n  json: {\n    missionId: $('Parse Mission Event').first().json.missionId,\n    status: 'completed',\n    result: result,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "func-callback",
      "name": "Build Callback",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "url": "={{ $('Parse Mission Event').first().json.callbackUrl }}",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "missionId", "value": "={{ $json.missionId }}" },
            { "name": "status", "value": "={{ $json.status }}" },
            { "name": "result", "value": "={{ JSON.stringify($json.result) }}" }
          ]
        },
        "options": {}
      },
      "id": "http-callback",
      "name": "Update Dashboard Activity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1450, 200]
    }
  ],
  "connections": {
    "Mission Event Webhook": { "main": [[{ "node": "Parse Mission Event", "type": "main", "index": 0 }]] },
    "Parse Mission Event": { "main": [[{ "node": "Is Approved?", "type": "main", "index": 0 }]] },
    "Is Approved?": {
      "main": [
        [{ "node": "Run External Integration", "type": "main", "index": 0 }],
        []
      ]
    },
    "Run External Integration": { "main": [[{ "node": "Write Results to Supabase", "type": "main", "index": 0 }]] },
    "Write Results to Supabase": { "main": [[{ "node": "Build Callback", "type": "main", "index": 0 }]] },
    "Build Callback": { "main": [[{ "node": "Update Dashboard Activity", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "errorWorkflow": "litt-failure-alerts" }
}
