# ─────────────────────────────────────────────────────────────────────────────
# n8n Environment Variables — Railway Deployment
# ─────────────────────────────────────────────────────────────────────────────
# Copy these to Railway → Variables tab for the n8n service.
# DO NOT commit actual secret values to this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core n8n config ──
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
# Do NOT set N8N_EDITOR_BASE_URL — we want the editor accessible only via tunnel
NODE_ENV=production

# ── Database (Postgres on Railway — add a Postgres service and link it) ──
# Get these from Railway → Postgres service → Connect tab
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=__RAILWAY_PG_HOST__
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=railway
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=__RAILWAY_PG_PASSWORD__
# SSL is required for Railway Postgres
DB_POSTGRESDB_SSL=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# ── Auth — editor access (required since we're not exposing publicly) ──
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=__GENERATE_STRONG_PASSWORD__

# ── Encryption key (for credential storage) ──
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=__GENERATE_64_CHAR_HEX__

# ── Webhook URL — the Next.js bridge will forward to this ──
# Set this to the Railway private service URL (or the public URL if using a domain)
# The bridge in /api/n8n/* will POST to: ${N8N_WEBHOOK_URL}/webhook/{path}
N8N_WEBHOOK_URL=__SET_AFTER_RAILWAY_DEPLOY__

# ── Disable n8n's own public webhook server (we use the bridge) ──
N8N_DISABLE_PRODUCTION_MAIN_PROCESS=false
WEBHOOK_URL=__SET_AFTER_RAILWAY_DEPLOY__

# ── Timezone ──
GENERIC_TIMEZONE=America/New_York

# ── n8n license (Community Edition = no license key needed) ──
# Leave N8N_LICENSE unset for Community Edition

# ── AI provider keys (for n8n AI nodes) ──
# These are OPTIONAL — n8n can also use credentials stored in its vault
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...

# ── LiTTree Lab Studios integration keys ──
# The webhook bridge uses this shared secret to authenticate requests
LITT_N8N_BRIDGE_SECRET=__GENERATE_SHARED_SECRET__

# ── Supabase (for GitHub+Supabase sync workflows) ──
SUPABASE_URL=https://rokbfvuoqildggnhappy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__SET_FROM_MAIN_APP__

# ── GitHub (for GitHub+Supabase sync workflows) ──
GITHUB_TOKEN=__SET_GITHUB_PAT__

# ── Gmail (for email automation) ──
# Configure via n8n's OAuth2 credential vault, not env vars

# ── Stripe (for customer onboarding webhooks) ──
STRIPE_SECRET_KEY=__SET_FROM_MAIN_APP__
STRIPE_WEBHOOK_SECRET=__SET_FROM_MAIN_APP__
