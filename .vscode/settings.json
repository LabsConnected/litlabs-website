{
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "editor.formatOnSave": false,
  "tailwindCSS.lint.recommended": false,
  "tailwindCSS.lint.invalidConfigPath": "ignore",
  "tailwindCSS.lint.cssConflict": "ignore",
  "mssql.intelliSense.enableErrorChecking": false,
  "mssql.intelliSense.enableIntelliSense": false,
  "mssql.intelliSense.enableSuggestions": false,
  "mssql.intelliSense.enableQuickInfo": false,
  "cSpell.words": ["notif", "conname", "Vercel", "Supabase", "vercel", "supabase", "timestamptz"],
  "files.associations": {
    "**/supabase/**/*.sql": "postgres",
    "**/*.pg.sql": "postgres"
  },
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/.pnpm-store": true,
    "**/.pnpm-store9": true,
    "litlabs": true,
    "litlabs-website": true,
    "work": true,
    "OmniRoute": true,
    "Zoo-Code": true,
    "meta": true,
    "chrome": true
  }
}
