{
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "editor.formatOnSave": false,
  "tailwindCSS.lint.recommended": false,
  "tailwindCSS.lint.invalidConfigPath": "ignore",
  "tailwindCSS.lint.cssConflict": "ignore",
  "mssql.intelliSense.enable": false,
  "sql.validate.enable": false,
  "cSpell.words": ["notif"],
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/.pnpm-store": true,
    "**/.pnpm-store9": true,
    "litlabs": true,
    "litlabs-website": true,
    "work": true,
    "OmniRoute": true,
    "Zoo-Code": true,
    "meta": true,
    "chrome": true
  }
}
