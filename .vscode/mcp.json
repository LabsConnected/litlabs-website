{
  "servers": {
    "console-ninja": {
      "command": "cmd.exe",
      "args": ["/c", "node", "%USERPROFILE%/.console-ninja/mcp/index.js"]
    },
    "playwright-qa": {
      "command": "node",
      "args": ["${workspaceFolder}/tools/qa/qa-launch.mjs"],
      "env": {
        "QA_TARGET_URL": "https://<preview-name>.up.railway.app"
      }
    }
  }
}
