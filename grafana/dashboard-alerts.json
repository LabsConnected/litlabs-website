{
  "title": "LiTTree Lab Studios — Alert Rules",
  "uid": "litlabs-alerts",
  "tags": ["litlabs", "alerts"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "🚨 Disk Space < 10% Free",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "(windows_logical_disk_free_bytes / windows_logical_disk_size_bytes) * 100 < 10",
        "legendFormat": "{{volume}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "title": "🚨 Memory Usage > 90%",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "(1 - (windows_os_visible_memory_bytes / windows_cs_physical_memory_bytes)) * 100 > 90",
        "legendFormat": "memory",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 3,
      "title": "🚨 Alloy Remote Write Failures",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "increase(prometheus_remote_storage_samples_failed_total[5m]) > 0",
        "legendFormat": "failures (5m)",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "id": 4,
      "title": "🚨 LLM Error Rate > 10%",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "(sum(rate(litlabs_llm_calls_total{status=\"error\"}[5m])) / sum(rate(litlabs_llm_calls_total[5m]))) * 100 > 10",
        "legendFormat": "error %",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "id": 5,
      "title": "🚨 LLM p95 Latency > 30s",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by(le) (rate(litlabs_llm_latency_seconds_bucket[5m]))) > 30",
        "legendFormat": "p95 latency",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "id": 6,
      "title": "🚨 Alloy Service Down",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "up{job=\"integrations/alloy\"} == 0",
        "legendFormat": "alloy",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "id": 7,
      "title": "🚨 Next.js App Down",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "up{job=\"litlabs/app\"} == 0",
        "legendFormat": "app",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "id": 8,
      "title": "🚨 Eval Score < 0.5",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "litlabs_eval_score < 0.5",
        "legendFormat": "{{dimension}} / {{agent}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "id": 9,
      "title": "🚨 High LLM Failover Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "sum(rate(litlabs_llm_failover_total[5m])) > 0.5",
        "legendFormat": "failover/s",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }
        }
      }
    }
  ]
}
