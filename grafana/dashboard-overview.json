{
  "title": "LiTTree Lab Studios — Host & App Overview",
  "uid": "litlabs-overview",
  "tags": ["litlabs", "windows", "app"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage % (per core)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "100 - (avg by(core) (rate(windows_cpu_time_total{mode=\"idle\"}[5m])) * 100)",
        "legendFormat": "Core {{core}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 2,
      "title": "Memory Usage %",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "(1 - (windows_memory_physical_free_bytes / windows_memory_physical_total_bytes)) * 100",
        "legendFormat": "Used",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": {
          "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 70 },
            { "color": "red", "value": 90 }
          ]
        }}
      }
    },
    {
      "id": 3,
      "title": "Disk Space Free (GB)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "windows_logical_disk_free_bytes / 1073741824",
        "legendFormat": "{{volume}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "decgbytes" } }
    },
    {
      "id": 4,
      "title": "LLM Calls (rate/s by provider)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "sum by(provider) (rate(litlabs_llm_calls_total[5m]))",
        "legendFormat": "{{provider}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 5,
      "title": "LLM Latency (p95 by provider)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by(provider, le) (rate(litlabs_llm_latency_seconds_bucket[5m])))",
        "legendFormat": "{{provider}} p95",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "title": "LLM Errors vs Success",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [
        {
          "expr": "sum by(status) (rate(litlabs_llm_calls_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 7,
      "title": "Token Usage (rate/s by type)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "sum by(type) (rate(litlabs_llm_tokens_total[5m]))",
        "legendFormat": "{{type}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 8,
      "title": "Provider Failovers",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "sum by(from_provider) (rate(litlabs_llm_failover_total[5m]))",
        "legendFormat": "from {{from_provider}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 9,
      "title": "Agent Runs (rate/s by agent)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "sum by(agent) (rate(litlabs_agent_runs_total[5m]))",
        "legendFormat": "{{agent}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 10,
      "title": "Agent Run Duration (p95 by agent)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by(agent, le) (rate(litlabs_agent_run_duration_seconds_bucket[5m])))",
        "legendFormat": "{{agent}} p95",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 11,
      "title": "Eval Scores (latest by dimension)",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "litlabs_eval_score",
        "legendFormat": "{{dimension}} / {{agent}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": {
          "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 0.5 },
            { "color": "green", "value": 0.8 }
          ]
        }}
      }
    },
    {
      "id": 12,
      "title": "Network Throughput (bytes/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "rate(windows_net_bytes_received_total[5m])",
        "legendFormat": "rx {{nic}}",
        "refId": "A"
      },
      {
        "expr": "rate(windows_net_bytes_sent_total[5m])",
        "legendFormat": "tx {{nic}}",
        "refId": "B"
      }],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "id": 13,
      "title": "Alloy Remote Write Health",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [
        {
          "expr": "prometheus_remote_storage_samples_total{remote_name=~\".+\"}",
          "legendFormat": "sent",
          "refId": "A"
        },
        {
          "expr": "prometheus_remote_storage_samples_failed_total{remote_name=~\".+\"}",
          "legendFormat": "failed",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 14,
      "title": "Node.js Process Memory (app)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "nodejs_heap_size_used_bytes / 1048576",
        "legendFormat": "heap used (MB)",
        "refId": "A"
      },
      {
        "expr": "nodejs_external_memory_used_bytes / 1048576",
        "legendFormat": "external (MB)",
        "refId": "B"
      }],
      "fieldConfig": { "defaults": { "unit": "MB" } }
    },
    {
      "id": 15,
      "title": "HTTP Request Rate (by route)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-vastantelope1841-prom" },
      "targets": [{
        "expr": "sum by(route) (rate(litlabs_http_requests_total[5m]))",
        "legendFormat": "{{route}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    }
  ]
}
