# LiTT Voice Bridge — Environment Variables

# OpenAI Realtime API
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Twilio (for webhook validation and phone number lookup)
TWILIO_ACCOUNT_SID=AC-your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Server
VOICE_BRIDGE_PORT=3001

# Next.js API (for user context lookup + tool execution)
# This must match the Next.js server URL (default: http://localhost:3000)
NEXT_PUBLIC_API_BASE=http://localhost:3000

# Internal API Key (must match INTERNAL_API_KEY in the Next.js .env.local)
# Used for server-to-server auth between the voice bridge and Next.js API.
# The voice bridge calls /api/internal/voice-context and /api/internal/web-intelligence
# with this key in the x-internal-api-key header.
INTERNAL_API_KEY=your-internal-api-key-here
