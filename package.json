{
  "name": "litlabs-website",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev --turbo -p 3001",
    "dev:webpack": "next dev --webpack -p 3001",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "prebuild": "node -e \"if(require('fs').existsSync('scripts/verify-emulatorjs-assets.mjs')){process.exitCode=require('child_process').spawnSync('node',['scripts/verify-emulatorjs-assets.mjs'],{stdio:'inherit'}).status}else{console.log('Skipping emulatorjs verify (scripts/ not deployed)')}\"",
    "sync:emulatorjs": "node scripts/sync-emulatorjs-assets.mjs",
    "verify:emulatorjs": "node scripts/verify-emulatorjs-assets.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:public": "playwright test --project=public-chromium",
    "test:e2e:auth": "playwright test --project=authenticated-chromium",
    "test:e2e:golden": "playwright test golden-journey.spec.ts --headed",
    "test:e2e:production": "playwright test --grep=\"@production|@smoke\"",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit --project tsconfig.test.json",
    "clean": "powershell -Command \"Remove-Item .next -Recurse -Force -ErrorAction SilentlyContinue\"",
    "clean:dist": "powershell -Command \"Remove-Item .next -Recurse -Force -ErrorAction SilentlyContinue\"",
    "rebuild": "pnpm clean && pnpm build",
    "kill-build": "powershell -Command \"Get-Process node -ErrorAction SilentlyContinue | Where-Object { $_.StartTime -gt (Get-Date).AddMinutes(-5) } | Stop-Process -Force -ErrorAction SilentlyContinue\"",
    "terminal:dev": "pnpm --filter @litt/agent-core build && tsx terminal-server/server.ts",
    "terminal:build": "tsc -p terminal-server/tsconfig.json",
    "terminal:start": "node terminal-server/dist/server.js",
    "terminal:build-image": "docker build -t littree-terminal:latest -f docker/Dockerfile.terminal .",
    "daemon:dev": "tsx src/daemon.ts",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm terminal:dev\" \"pnpm daemon:dev\"",
    "mobile:start": "pnpm --filter @litt/companion start",
    "mobile:check": "pnpm --filter @litt/companion typecheck",
    "mobile:doctor": "pnpm --filter @litt/companion exec npx --yes expo-doctor",
    "mobile:verify": "pnpm mobile:doctor && pnpm mobile:check",
    "diagnose:connections": "tsx scripts/diagnose-connections.ts",
    "sync:vapi-tools": "tsx scripts/sync-vapi-tools.ts",
    "sync:vapi-bridge": "tsx scripts/sync-vapi-bridge.ts",
    "test:ghl-payload": "tsx scripts/test-ghl-payload.ts",
    "audit:product-truth": "tsx scripts/audit-product-truth.ts",
    "mobile:check": "pnpm --filter @litt/companion check",
    "mobile:start": "pnpm --filter @litt/companion start",
    "mobile:build": "pnpm --filter @litt/companion build:android",
    "mobile:doctor": "pnpm --filter @litt/companion doctor",
    "litt:doctor": "tsx scripts/litt-doctor.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@browserbasehq/sdk": "^2.16.0",
    "@browserbasehq/stagehand": "^3.7.1",
    "@clerk/nextjs": "^6.39.5",
    "@google/genai": "^2.11.0",
    "@google/generative-ai": "^0.24.1",
    "@google/model-viewer": "^4.3.1",
    "@marsidev/react-turnstile": "^1.5.5",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.2.10",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.106.2",
    "@types/react-grid-layout": "^2.1.0",
    "@types/ws": "^8.18.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "braintrust": "^3.27.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "framer-motion": "^13.0.0",
    "hash-wasm": "^4.12.0",
    "immer": "^11.1.15",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "monaco-editor": "0.55.1",
    "next": "^16.2.11",
    "nuqs": "^2.9.5",
    "prom-client": "^15.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-grid-layout": "^2.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "socket.io-client": "4.8.3",
    "stripe": "^18.0.0",
    "supermemory": "^4.24.12",
    "svix": "^1.95.1",
    "ws": "^8.21.1",
    "xterm-addon-web-links": "0.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@clerk/testing": "^2.2.15",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^25.4.0",
    "socket.io": "4.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "nanoid@<3.3.17": "3.3.18",
      "socket.io-parser@<4.2.7": "4.2.7",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9"
    }
  }
}
