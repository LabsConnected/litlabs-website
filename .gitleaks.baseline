  "Commit": "294814a2f75082eca2eb6b4314dffbf436bc4cd0",
  "Link": "https://github.com/LabsConnected/litlabs-website/blob/294814a2f75082eca2eb6b4314dffbf436bc4cd0/packages/litt-agent-core/src/__tests__/sec5-credential-broker.test.ts#L64",
  "Entropy": 4.7338696,
