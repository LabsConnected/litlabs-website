# e2e/env.e2e — isolated E2E server environment (Checkpoint 2 fills this in)
#
# Copy this file to e2e/env.e2e (untracked, matched by .gitignore .env*).
# ONLY keys on APP_ENV_ALLOWLIST in playwright.e2e.config.ts are forwarded to
# the server-under-test; anything else in this file is ignored by design.
#
# HARD RULES
# - No production or staging values. No live keys of any kind.
# - Clerk values must be the DEV instance (pk_test_*/sk_test_*) used only for
#   E2E. If a dedicated dev instance cannot be provided, leave the Clerk block
#   unset — the e2e-authenticated project stays gated off.
# - Supabase values come from `supabase --workdir <this worktree> start`
#   output for project_id LiTTreeLabStudio_E2E (local demo keys are fine —
#   they are generated per local stack, not real credentials).

# ── App URLs (loopback only) ──
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_BASE=http://127.0.0.1:3001
NEXT_PUBLIC_MEDIA_BASE=http://127.0.0.1:3001

# ── Clerk DEV instance (gate: E2E_CLERK_AUTH) ──
# UNRESOLVED GATE — do not fill with live keys. Leave unset until a dedicated
# dev instance + disposable test user (CLERK_TEST_USER_E2E_EMAIL) exist.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=__UNRESOLVED_CLERK_DEV_PK__
CLERK_PUBLISHABLE_KEY=__UNRESOLVED_CLERK_DEV_PK__
CLERK_SECRET_KEY=__UNRESOLVED_CLERK_DEV_SK__
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/studio
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/studio

# ── Supabase LiTTreeLabStudio_E2E (ports from this worktree's config.toml) ──
# Values emitted by `supabase status -o env` after the E2E stack starts:
#   API_URL → NEXT_PUBLIC_SUPABASE_URL (http://127.0.0.1:55321)
#   ANON_KEY / PUBLISHABLE_KEY → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SERVICE_ROLE_KEY / SECRET_KEY → SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=__FILLED_FROM_SUPABASE_STATUS__
SUPABASE_SERVICE_ROLE_KEY=__FILLED_FROM_SUPABASE_STATUS__
SUPABASE_JWT_SECRET=__FILLED_FROM_SUPABASE_STATUS__

# ── Terminal/workspace backend (required by /api/studio-projects/*/files) ──
# The canvas file route proxies to a terminal-server. For isolation this must
# be an E2E-scoped terminal-server with a scratch TERMINAL_WORKSPACE_ROOT —
# never the production terminal-server.
TERMINAL_SERVER_INTERNAL_URL=__UNRESOLVED_E2E_TERMINAL_SERVER__
TERMINAL_PUBLIC_URL=__UNRESOLVED_E2E_TERMINAL_SERVER__
TERMINAL_INTERNAL_SERVICE_KEY=__UNRESOLVED_E2E_TERMINAL_KEY__
TERMINAL_AUTH_SECRET=__UNRESOLVED_E2E_TERMINAL_SECRET__
TERMINAL_ALLOWED_ORIGIN=http://127.0.0.1:3001
NEXT_PUBLIC_TERMINAL_HTTP_URL=__UNRESOLVED_E2E_TERMINAL_SERVER__
NEXT_PUBLIC_TERMINAL_WS_URL=__UNRESOLVED_E2E_TERMINAL_WS__

# ── Runner-side gates (read by Playwright, not forwarded to the server) ──
# Set in the shell when invoking playwright, NOT in this file:
#   E2E_STACK_READY=true        → enables webServer spawn + unskips suites
#   E2E_CLERK_AUTH=true         → enables e2e-auth-setup + e2e-authenticated
#   E2E_AUTH_STATE=<path>       → storage state file (default tests/playwright-e2e/.clerk/user-e2e.json)
#   CLERK_TEST_USER_E2E_EMAIL   → disposable dev-instance user for auth.setup.ts
