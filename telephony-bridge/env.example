# ─────────────────────────────────────────────────────────────────────────────
# litlabs-telephony-bridge — Environment Variables (NAMES ONLY, Phase 2A prep)
# ─────────────────────────────────────────────────────────────────────────────
# This service is NOT deployed. Nothing here is a live credential. Copy to
# Railway -> Variables only when Phase 2 deployment is separately authorized.
# Isolated from litlabs-voice-proxy: do not set these on that service, and do
# not reuse VOICE_AUTH_SECRET here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Twilio (Phase 2 — not yet set anywhere, no API calls made until set) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Existing toll-free trial number (owner decision 2026-10-22) — not a
# secret, just this service's caller ID. No new number is purchased.
TWILIO_PHONE_NUMBER=+18772838063

# ── Dex bridge auth (separate secret from VOICE_AUTH_SECRET) ──
DEX_BRIDGE_SECRET=

# ── Feature gates — all default to the safe/disabled state ──
# "true" switches the call-request route from the hard-coded deny repo to
# the real Supabase-backed repo. The repo itself still fails closed.
DEX_STAGING_REPO_ENABLED=false
# Stays false until toll-free verification completes (owner requirement).
DEX_SMS_ENABLED=false

# ── Call transfer target ──
# Owner's personal number, set directly in Railway by the owner — never
# written into code, docs, or git. Read by name only.
DEX_TRANSFER_TARGET_NUMBER=

# ── Supabase (reuses the existing project — same as the main `web` service) ──
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
